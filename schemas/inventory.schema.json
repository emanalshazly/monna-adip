{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emanalshazly/monna-adip/blob/main/schemas/inventory.schema.json",
  "title": "MONNA ADIP Inventory",
  "type": "object",
  "required": ["system", "data_objects", "actions"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "data_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "format", "fields"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "format": {"enum": ["json", "xml", "markdown", "dom", "custom", "unstructured"]},
          "structural_isolation": {"type": "boolean"},
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "trust", "origin", "security_role"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "trust": {"enum": ["trusted", "untrusted", "derived", "unknown"]},
                "origin": {"type": "string"},
                "security_role": {
                  "enum": ["content", "identifier", "origin", "authorization", "tool_history", "verification_result", "action_argument"]
                },
                "provenance_preserved": {"type": "boolean"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "impact", "parameters"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "impact": {"enum": ["low", "medium", "high", "critical"]},
          "user_confirmation": {"type": "boolean"},
          "independent_confirmation_evidence": {"type": "boolean"},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "source"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "source": {
                  "type": "object",
                  "required": ["object", "field"],
                  "properties": {
                    "object": {"type": "string"},
                    "field": {"type": "string"}
                  }
                },
                "deterministic_validation": {"type": "boolean"},
                "provenance_check": {"type": "boolean"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
